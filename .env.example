# Pulse Board — Kamal deploy env vars (root-level).
#
# PREFERRED: set every value below as a GitHub Environment secret (or
# variable, for non-sensitive ones) under
#   Settings → Environments → production
# The deploy workflow at .github/workflows/deploy.yml reads them via
# ${{ secrets.* }} / ${{ vars.* }} and templates them into Kamal's
# environment for you. No file edits required.
#
# LOCAL FALLBACK: when you run `kamal deploy` from your laptop (only
# ever needed for the one-time `kamal setup`, or for an emergency
# manual deploy), copy this file to `.env` (gitignored) and fill in
# the values. The dotenv loader at the top of config/deploy.yml picks
# them up. Never commit a real `.env`.

# ─── Required ────────────────────────────────────────────────────────
# Anything left blank here will be missing in production.

# SSH target for Kamal — IP or DNS name of the box Kamal SSHes into.
KAMAL_SERVER_HOST=

# Public domain — kamal-proxy routes by this and provisions Let's
# Encrypt TLS for it. DNS A record must already point at KAMAL_SERVER_HOST.
KAMAL_DEPLOY_HOST=

# Postgres accessory password — also composed into DATABASE_URL.
POSTGRES_PASSWORD=

# Three app secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CSRF_SECRET=
COOKIE_SECRET=

# ─── Registry (Kamal needs these to push / pull the image) ───────────
# For GHCR via GitHub Actions, the workflow auto-fills:
#   KAMAL_REGISTRY_USERNAME = github.actor
#   KAMAL_REGISTRY_PASSWORD = GITHUB_TOKEN (packages: write granted)
# You only need to set them here for LOCAL `kamal setup` / `kamal deploy`,
# or to override the GHCR defaults (Docker Hub, a different account, etc.).
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# Owner segment of the image path. In CI, GitHub auto-injects this.
# Locally, set it to your GitHub user/org. The full image becomes
# ghcr.io/<this>/<KAMAL_SERVICE>.
GITHUB_REPOSITORY_OWNER=

# ─── Optional — overrides for non-sensitive defaults ─────────────────
# These all have defaults in config/deploy.yml; only set if you need
# to differ from them (e.g. forking pulse-board into another app).

# Kamal service name. Drives container, volume, and accessory hostnames.
# Default: pulse-board
KAMAL_SERVICE=

# Container registry. Default: ghcr.io
KAMAL_REGISTRY_SERVER=

# Image override — if you want to push to a path that doesn't match
# <owner>/<service>. Default: <owner>/<service>
KAMAL_IMAGE=
KAMAL_BUILD_CACHE_IMAGE=

# App port inside the container. Default: 3000
APP_PORT=

# Postgres accessory user + DB name. Defaults: pulse / pulse_board_production
POSTGRES_USER=
POSTGRES_DB=

# Rate limit on POST /api/public/elections/:customUrl/responses.
# Defaults: 900000 (ms = 15 min window) / 100 (requests per window).
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Public origin used for absolute URLs in outbound email. The CI
# workflow composes this as https://${KAMAL_DEPLOY_HOST} automatically;
# only set it here for local deploys.
PUBLIC_ORIGIN=

# ─── Optional — email + demo seed ────────────────────────────────────
# Without these the app still boots. Brevo unset = results emails and
# password-reset emails fall back to console.log.

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Demo admin credentials loaded by `npm run db:seed`.
GUEST_DEMO_EMAIL=
GUEST_DEMO_PASSWORD=
