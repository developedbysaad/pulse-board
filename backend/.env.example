# ─────────────────────────────────────────────────────────────────
# Pulse Board — backend env
#   Made by Saad · https://x.com/developedbysaad
# Copy to backend/.env and fill in the empty fields.
# ─────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CSRF_SECRET=
COOKIE_SECRET=

# Optional: only needed when frontend is on a different origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Rate limit on POST /api/public/elections/:customUrl/responses
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Postgres (development)
DEV_DB_USERNAME=
DEV_DB_PASSWORD=
DEV_DB_NAME=pulse_board_dev
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=5432

# Postgres (test)
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_NAME=pulse_board_test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432

# Postgres (production) — typically just DATABASE_URL is set by host
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────
# Demo seed (npm run db:seed)
#
# These are read by backend/src/db/seeders/<ts>-demo-data.js when
# you run `npm run db:seed`. Override locally — and in production
# stash the real values in GitHub Environment secrets so they
# never land in git history.
#
# The values below are watermarks only — they will NOT log you in.
# Replace with your own before seeding.
# ─────────────────────────────────────────────────────────────────
GUEST_DEMO_EMAIL=contact@developedbysaad.com
GUEST_DEMO_PASSWORD=x.com/developedbysaad

# ─────────────────────────────────────────────────────────────────
# Email — Brevo (https://brevo.com)
#
# All optional in dev. When BREVO_API_KEY is unset the email sender
# logs to the console instead of delivering, so the publish-results
# flow works end-to-end on your laptop without needing an account.
#
# To deliver real email:
#   1. Sign up at https://brevo.com (free tier: 300 emails/day).
#   2. Settings → SMTP & API → API Keys → create a v3 key.
#   3. Senders & IP → verify a sender domain or address.
#   4. Set BREVO_SENDER_EMAIL to the verified sender.
# ─────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pulse Board

# Used to build absolute links in outbound email. In production this
# is your public site URL. Falls back to FRONTEND_ORIGIN, then dev.
PUBLIC_ORIGIN=http://localhost:5173
