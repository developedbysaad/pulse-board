# Pulse Board — Kamal secrets template.
#
# SAFE TO COMMIT. Every value below is a `$VAR` reference, not a literal
# secret. Kamal reads this file at deploy time and substitutes each
# reference from the surrounding process environment:
#
#   - In CI: the env block of .github/workflows/deploy.yml exports each
#     secret as a runner env var; Kamal reads them here.
#   - Locally: the dotenv loader at the top of config/deploy.yml loads
#     .env (gitignored), so the env vars are present when Kamal runs.
#
# Never add literal values to this file. If you need to forward a new
# secret, add a line `NEW_SECRET=$NEW_SECRET` and make sure the env
# block in deploy.yml lists it under `env.secret:`.

KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

POSTGRES_PASSWORD=$POSTGRES_PASSWORD

DATABASE_URL=postgres://${POSTGRES_USER:-pulse}:${POSTGRES_PASSWORD}@${KAMAL_SERVICE:-pulse-board}-db:5432/${POSTGRES_DB:-pulse_board_production}

SESSION_SECRET=$SESSION_SECRET
CSRF_SECRET=$CSRF_SECRET
COOKIE_SECRET=$COOKIE_SECRET

PUBLIC_ORIGIN=$PUBLIC_ORIGIN

BREVO_API_KEY=$BREVO_API_KEY
BREVO_SENDER_EMAIL=$BREVO_SENDER_EMAIL
BREVO_SENDER_NAME=$BREVO_SENDER_NAME

GUEST_DEMO_EMAIL=$GUEST_DEMO_EMAIL
GUEST_DEMO_PASSWORD=$GUEST_DEMO_PASSWORD
